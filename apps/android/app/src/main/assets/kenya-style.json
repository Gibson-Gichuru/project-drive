{
  "version": 8,
  "name": "Outset Kenya",
  "glyphs": "__BASE_URL__/maps/fonts/{fontstack}/{range}",
  "sources": {
    "kenya": {
      "type": "vector",
      "tiles": [
        "__BASE_URL__/maps/tiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">\u00a9 OpenStreetMap contributors</a> \u00b7 <a href=\"https://openmaptiles.org/\">\u00a9 OpenMapTiles</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f6f8"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "kenya",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#d7f4df",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "kenya",
      "source-layer": "park",
      "paint": {
        "fill-color": "#bceacd",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "kenya",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#eceff1",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "kenya",
      "source-layer": "water",
      "paint": {
        "fill-color": "#b4deef"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "kenya",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#b4deef",
        "line-width": 1.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "kenya",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e0e4e9",
        "fill-outline-color": "#d5dbe1"
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "kenya",
      "source-layer": "transportation",
      "filter": [
        "!=",
        "class",
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#aab6c4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          12,
          3,
          16,
          10
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "kenya",
      "source-layer": "transportation",
      "filter": [
        "!=",
        "class",
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#b8c4d1",
          "primary",
          "#c6d0db",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.3,
          12,
          2,
          16,
          7
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "kenya",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#46535e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "kenya",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          11,
          14,
          16
        ]
      },
      "paint": {
        "text-color": "#374851",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
