# Local development only. Copy to .env; never use these credentials outside this workstation.
POSTGRES_DB=project_drive
POSTGRES_USER=project_drive
POSTGRES_PASSWORD=local_project_drive_only
DATABASE_URL=postgres://project_drive:local_project_drive_only@db:5432/project_drive?sslmode=disable
API_ADDR=:8080
APP_ENV=local

# Optional local/test-only Ed25519 public key; see docs/milestones/M2.md.
# Keep the private seed outside this repository. Empty means all trip routes return 401.
DEV_AUTH_PUBLIC_KEY=
