# Local development only. Copy to .env; never use these credentials outside this workstation.
POSTGRES_DB=project_drive
POSTGRES_USER=project_drive
POSTGRES_PASSWORD=local_project_drive_only
DATABASE_URL=postgres://project_drive:local_project_drive_only@db:5432/project_drive?sslmode=disable
API_ADDR=:8080
APP_ENV=local

# Optional local/test-only Ed25519 public key; see docs/milestones/M2.md.
# Keep the private seed outside this repository. Empty means all trip routes return 401.
DEV_AUTH_PUBLIC_KEY=

# Optional bounded single-instance tracking limits (defaults shown; no credentials).
TRACK_MAX_CONNECTIONS=64
TRACK_MAX_PER_USER=2
TRACK_MAX_TRIPS=16
TRACK_MAX_POSITIONS=1024
TRACK_QUEUE_SIZE=16
TRACK_MESSAGE_BYTES=4096
TRACK_UPDATES_PER_SECOND=2
TRACK_BURST=5
TRACK_STALE_AFTER=10s
TRACK_POSITION_TTL=30s
TRACK_MAX_AGE=15s
TRACK_FUTURE_SKEW=5s
TRACK_SWEEP_INTERVAL=1s
TRACK_WRITE_TIMEOUT=1s
TRACK_PING_INTERVAL=15s
TRACK_PONG_TIMEOUT=5s
