digraph G { graph [bgcolor="white",pad="0.3",nodesep="0.55",ranksep="0.65",fontname="DejaVu Sans"]; node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#64748b",fontname="DejaVu Sans",fontsize=11,margin="0.16,0.12"]; edge [color="#475569",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7]; rankdir=LR; GPS[label="Fused GPS"]; IMU[label="Accelerometer + rotation"]; Filter[label="Quality filtering\norientation + timestamps"]; Detect[label="Candidate events\nbraking / acceleration / cornering"]; Buffer[label="Local bounded buffer"]; Upload[label="Batch upload API"]; DB[label="Trip event storage"]; Summary[label="Trip summary + future heatmap"]; GPS->Filter;IMU->Filter;Filter->Detect;Detect->Buffer;Buffer->Upload;Upload->DB;DB->Summary;}